# =============================================================================
# PRODUCTION — sao chép thành `.env.production` (hoặc be.env trên server), KHÔNG commit.
# Dùng bởi docker-compose.prod.yml / deploy/maymay. Backend từ chối khởi động nếu
# trỏ localhost, DB/bucket dev, Mailpit, JWT_SECRET yếu (xem app/core/env_guard.py).
# Sinh JWT_SECRET: openssl rand -hex 32
# =============================================================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=studynest
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_ASYNC_URL=postgresql+asyncpg://admin:CHANGE_ME@postgres:5432/studynest



# === JWT ===
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=10
AUTH_ALLOW_COOKIE_COMPAT=False
# Server-to-server cookie refresh only. Configure the same high-entropy value in Next server code.
AUTH_INTERNAL_REFRESH_SECRET=
AUTH_ALLOW_UNBOUND_BEARER=False
# Public API origin for DPoP. Empty uses BACKEND_URL. Include scheme and any non-default port.
PUBLIC_API_URL=https://api.may-may.tech
# Set only if a trusted reverse proxy strips this prefix from the ASGI request path.
DPOP_STRIPPED_PUBLIC_PATH_PREFIX=
DPOP_IAT_LEEWAY_SECONDS=60
DPOP_JTI_TTL_SECONDS=120
DPOP_JTI_FAIL_OPEN_ON_GET=False
ALGORITHM=HS256

# === Chat AI provider (gemini or 9router) ===
LLM_PROVIDER=9router
NINEROUTER_BASE_URL=https://9router.itup.io.vn/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=gemini
NINEROUTER_AUTO_MODEL=mixed
NINEROUTER_TIMEOUT_SECONDS=120
NINEROUTER_STREAM=True
# Optional fast 9Router model for lesson tutor only; empty uses admin model.
TUTOR_CHAT_MODEL=

# Embedding provider is separate from the chat model selected in Admin.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# === Google APIs (embeddings, video analysis and optional Gemini chat) ===
GOOGLE_API_KEY=
GOOGLE_API_KEY_CHAT=
GOOGLE_API_CLIENT_ID_LOGIN_GOOGLE=
GOOGLE_API_SECRET_ID_LOGIN_GOOGLE=

# === Piston API ===
PISTON_URL=http://piston:2000
# Required when using the authenticated hosted runner; never expose to frontend.
PISTON_API_KEY=

# === PayPal ===
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.paypal.com

# === Local mail (Mailpit inbox: http://localhost:8025) ===
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@may-may.tech
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=True
MAIL_SSL=False

# === Microsoft Graph (Optional) ===
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_BASE=

# === Hugging Face ===
HF_TOKEN=

# === App URLs ===
FRONTEND_URL=https://may-may.tech
BACKEND_URL=https://api.may-may.tech

# === Redis / Presence ===
REDIS_URL=redis://redis:6379/0
PRESENCE_TTL_SECONDS=90

# === Upload storage: R2 ===
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studynest
R2_SIGNED_URL_TTL_SECONDS=300
# Optional: approved corporate CA bundle for backend -> R2 TLS verification.
R2_CA_BUNDLE=
STORAGE_MAX_UPLOAD_BYTES=2147483648

# Qwen 3.8 Omni Flash Realtime (Voice Chat & Speaking Realtime): key remains on backend.
DASHSCOPE_API_KEY=
DASHSCOPE_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
DASHSCOPE_COMPATIBLE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_CHAT_MODEL=qwen3.8-omni-flash
TUTOR_VOICE_ENABLED=True
TUTOR_VOICE_MODEL=qwen3.8-omni-flash-realtime
TUTOR_VOICE_NAME=Tina
TUTOR_VOICE_MAX_SECONDS=600
TUTOR_VOICE_ORIGINS=https://may-may.tech
TUTOR_DICTATION_ENABLED=True
TUTOR_DICTATION_MODEL=qwen3-asr-flash-realtime
TUTOR_DICTATION_MAX_SECONDS=120

# Learning Agent Harness (enable only after additive Alembic upgrade and checks).
# With LLM_PROVIDER=9router, ag/gemini-3-flash passed the bounded planner smoke.
AGENT_ENABLED=False
AGENT_MODEL=
AGENT_MODEL_TIMEOUT_SECONDS=90
AGENT_RUN_MAX_SECONDS=240
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_ITERATIONS=6
AGENT_MAX_INPUT_TOKENS=8000000
AGENT_MAX_OUTPUT_TOKENS_TOTAL=12000
AGENT_MAX_RUNS_PER_MINUTE=20
AGENT_MAX_SESSIONS_PER_HOUR=60
AGENT_EVENT_RETENTION_DAYS=30
# Optional monetary admission uses operator-declared exact model prices.
# Set only when AGENT_MODEL_PRICES_JSON contains input/output USD per million.
# AGENT_MAX_RUN_COST_USD=0.10
AGENT_MODEL_PRICES_JSON={}
CODE_MAX_RUNS_PER_MINUTE=6
CODE_MAX_SECONDS=90
# Comma-separated exact HTTPS browser origins in production, never '*'.
CORS_ALLOWED_ORIGINS=https://may-may.tech

# Bundled MCP stdio server: public web search + public GitHub read tools.
# No developer GitHub credentials are inherited; private repositories are not enabled.
AGENT_MCP_ENABLED=True

# GitHub OAuth App callback: http://localhost:3000/api/agent/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://may-may.tech/api/agent/github/callback

# Native multimodal input (image pixels, not OCR-only context).
AGENT_VISION_PROVIDER=9router
AGENT_VISION_MODEL=ag/gemini-3.8-flash-low
TUTOR_TRANSCRIBE_MODEL=ag/gemini-3.8-flash-low
TUTOR_TRANSCRIBE_PROVIDER=9router

# Model-selected, evidence-backed long-term account memory (respects account consent)
AGENT_SEMANTIC_MEMORY_ENABLED=true
AGENT_MEMORY_TIMEOUT_SECONDS=12

# Semantic continuation checkpoints; select a fast text model supported by LLM_PROVIDER
AGENT_CONTEXT_PROVIDER=
AGENT_CONTEXT_MODEL=
AGENT_CONTEXT_TIMEOUT_SECONDS=30

# Optional exact model-window overrides; otherwise read provider model metadata.
AGENT_CONTEXT_WINDOWS_JSON={}
# Automatic semantic compaction triggers strictly above 80% of the model window.

# Realtime dictation: PCM16 -> input transcription only; no chat replies/audio storage.
TUTOR_DICTATION_ENABLED=True
# xAI streaming STT model, independent from batch STT.
TUTOR_DICTATION_MAX_SECONDS=120

# Hiển thị cấu hình mã thưởng nhiệm vụ sau khi tích hợp đối soát.
MISSION_COUPON_REWARDS_ENABLED=false
# Hiển thị mức ưu đãi dự kiến trong lịch thưởng cấp độ.
LEVEL_COUPON_REWARDS_ENABLED=false
APP_ENV=production

# --- DashScope (Qwen voice/dictation) ---
# Dùng API key RIÊNG cho từng môi trường; key Singapore (intl) và Beijing không dùng chung được.
# Với model qwen3.8-omni-flash-realtime, Alibaba yêu cầu domain theo workspace:
#   DASHSCOPE_WS_URL=wss://<WorkspaceId>.ap-southeast-1.maas.aliyuncs.com/api-ws/v1/realtime
# Model cũ vẫn dùng wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime (mặc định).
DASHSCOPE_API_KEY=
PAYPAL_REDIRECT_URI=https://api.may-may.tech/api/v1/lecturer/payout/callback
