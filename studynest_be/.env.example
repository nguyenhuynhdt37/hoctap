# === PostgreSQL (Lựa chọn 1 trong 3 cách kết nối bên dưới) ===
# Cách 3: Kết nối Remote Server qua Domain psql-maymay.itup.io.vn (đồng bộ từ xa)
POSTGRES_USER=admin
POSTGRES_PASSWORD=@Vinhuni1234
POSTGRES_DB=studynest
POSTGRES_HOST=psql-maymay.itup.io.vn
POSTGRES_PORT=5435
DATABASE_ASYNC_URL=postgresql+asyncpg://admin:%40Vinhuni1234@psql-maymay.itup.io.vn:5435/studynest

# Cách 1 (Dự phòng): Kết nối trực tiếp qua mạng Tailscale IP (khi máy có cài Tailscale)
# POSTGRES_HOST=100.122.190.92
# DATABASE_ASYNC_URL=postgresql+asyncpg://admin:%40Vinhuni1234@100.122.190.92:5435/studynest

# Cách Local: Chạy PostgreSQL Docker cục bộ trên máy cá nhân
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=change_me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5433
# DATABASE_ASYNC_URL=postgresql+asyncpg://admin:change_me@127.0.0.1:5433/studynest

# === JWT ===
JWT_SECRET=change_me_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === Chat AI provider (gemini or 9router) ===
LLM_PROVIDER=9router
NINEROUTER_BASE_URL=https://9router.itup.io.vn/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=gemini
NINEROUTER_AUTO_MODEL=mixed
NINEROUTER_TIMEOUT_SECONDS=120
NINEROUTER_STREAM=True
# Optional fast 9Router model for lesson tutor only; empty uses admin model.
TUTOR_CHAT_MODEL=

# Embedding provider is separate from the chat model selected in Admin.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# === Google APIs (embeddings, video analysis and optional Gemini chat) ===
GOOGLE_API_KEY=
GOOGLE_API_KEY_CHAT=
GOOGLE_API_CLIENT_ID_LOGIN_GOOGLE=
GOOGLE_API_SECRET_ID_LOGIN_GOOGLE=

# === Piston API ===
PISTON_URL=http://localhost:4000
# Required when using the authenticated hosted runner; never expose to frontend.
PISTON_API_KEY=

# === PayPal ===
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# === Local mail (Mailpit inbox: http://localhost:8025) ===
MAIL_USERNAME=dev
MAIL_PASSWORD=dev
MAIL_FROM=noreply@example.com
MAIL_PORT=1025
MAIL_SERVER=127.0.0.1
MAIL_TLS=False
MAIL_SSL=False

# === Microsoft Graph (Optional) ===
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_BASE=

# === Hugging Face ===
HF_TOKEN=

# === App URLs ===
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# === Redis / Presence ===
REDIS_URL=redis://localhost:6379/0
PRESENCE_TTL_SECONDS=90

# === Upload storage: R2 ===
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studynest
R2_SIGNED_URL_TTL_SECONDS=300
# Optional: approved corporate CA bundle for backend -> R2 TLS verification.
R2_CA_BUNDLE=
STORAGE_MAX_UPLOAD_BYTES=2147483648

# Grok Voice tutoring: key remains on backend, Redis enforces one active session/user.
XAI_API_KEY=
TUTOR_VOICE_ENABLED=True
TUTOR_VOICE_MODEL=grok-voice-latest
TUTOR_VOICE_NAME=eve
TUTOR_VOICE_MAX_SECONDS=600
TUTOR_VOICE_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Learning Agent Harness (enable only after additive Alembic upgrade and checks).
# With LLM_PROVIDER=9router, ag/gemini-3-flash passed the bounded planner smoke.
AGENT_ENABLED=False
AGENT_MODEL=
AGENT_MODEL_TIMEOUT_SECONDS=90
AGENT_RUN_MAX_SECONDS=240
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_ITERATIONS=6
AGENT_MAX_INPUT_TOKENS=8000000
AGENT_MAX_OUTPUT_TOKENS_TOTAL=12000
AGENT_MAX_RUNS_PER_MINUTE=20
AGENT_MAX_SESSIONS_PER_HOUR=60
AGENT_EVENT_RETENTION_DAYS=30
# Optional monetary admission uses operator-declared exact model prices.
# Set only when AGENT_MODEL_PRICES_JSON contains input/output USD per million.
# AGENT_MAX_RUN_COST_USD=0.10
AGENT_MODEL_PRICES_JSON={}
CODE_MAX_RUNS_PER_MINUTE=6
CODE_MAX_SECONDS=90
# Comma-separated exact HTTPS browser origins in production, never '*'.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bundled MCP stdio server: public web search + public GitHub read tools.
# No developer GitHub credentials are inherited; private repositories are not enabled.
AGENT_MCP_ENABLED=True

# GitHub OAuth App callback: http://localhost:3000/api/agent/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/agent/github/callback

# Native multimodal input (image pixels, not OCR-only context).
AGENT_VISION_PROVIDER=9router
AGENT_VISION_MODEL=ag/gemini-3.8-flash-low
TUTOR_TRANSCRIBE_MODEL=ag/gemini-3.8-flash-low
TUTOR_TRANSCRIBE_PROVIDER=9router

# Model-selected, evidence-backed long-term account memory (respects account consent)
AGENT_SEMANTIC_MEMORY_ENABLED=true
AGENT_MEMORY_TIMEOUT_SECONDS=12

# Semantic continuation checkpoints; select a fast text model supported by LLM_PROVIDER
AGENT_CONTEXT_PROVIDER=
AGENT_CONTEXT_MODEL=
AGENT_CONTEXT_TIMEOUT_SECONDS=30

# Optional exact model-window overrides; otherwise read provider model metadata.
AGENT_CONTEXT_WINDOWS_JSON={}
# Automatic semantic compaction triggers strictly above 80% of the model window.

# Realtime dictation: PCM16 -> input transcription only; no chat replies/audio storage.
TUTOR_DICTATION_ENABLED=True
# xAI streaming STT model, independent from batch STT.
TUTOR_DICTATION_MODEL=grok-voice-transcribe-2.0
TUTOR_DICTATION_MAX_SECONDS=120
