# === PostgreSQL ===
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=studynest
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_ASYNC_URL=postgresql+asyncpg://admin:change_me@127.0.0.1:5433/studynest

# === JWT ===
JWT_SECRET=change_me_to_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# === Chat AI provider (gemini or 9router) ===
LLM_PROVIDER=9router
NINEROUTER_BASE_URL=https://9router.itup.io.vn/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=gemini
NINEROUTER_AUTO_MODEL=mixed
NINEROUTER_TIMEOUT_SECONDS=120
NINEROUTER_STREAM=True

# Embedding provider is separate from the chat model selected in Admin.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

# === Google APIs (embeddings, video analysis and optional Gemini chat) ===
GOOGLE_API_KEY=
GOOGLE_API_KEY_CHAT=
GOOGLE_API_CLIENT_ID_LOGIN_GOOGLE=
GOOGLE_API_SECRET_ID_LOGIN_GOOGLE=

# === Piston API ===
PISTON_URL=http://localhost:4000

# === PayPal ===
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# === Local mail (Mailpit inbox: http://localhost:8025) ===
MAIL_USERNAME=dev
MAIL_PASSWORD=dev
MAIL_FROM=noreply@example.com
MAIL_PORT=1025
MAIL_SERVER=127.0.0.1
MAIL_TLS=False
MAIL_SSL=False

# === Microsoft Graph (Optional) ===
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=
GRAPH_BASE=

# === Hugging Face ===
HF_TOKEN=

# === App URLs ===
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# === Redis / Presence ===
REDIS_URL=redis://localhost:6379/0
PRESENCE_TTL_SECONDS=90

# === Upload storage: R2 ===
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=studynest
R2_SIGNED_URL_TTL_SECONDS=300
# Optional: approved corporate CA bundle for backend -> R2 TLS verification.
R2_CA_BUNDLE=
STORAGE_MAX_UPLOAD_BYTES=2147483648
