map_hash_bucket_size 256;
map $http_authorization $piston_authorized {
    default 0;
    "Bearer ${PISTON_API_KEY}" 1;
}
limit_req_zone $binary_remote_addr zone=piston_jobs:10m rate=5r/s;

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 1m;
    proxy_connect_timeout 5s;
    proxy_read_timeout 20s;
    proxy_send_timeout 20s;

    location = / {
        default_type application/json;
        return 200 '{"status":"ok","service":"studynest-code-runner"}';
    }
    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","service":"studynest-code-runner"}';
    }
    location = /api/v2/runtimes {
        if ($piston_authorized = 0) { return 401; }
        limit_except GET { deny all; }
        proxy_set_header Authorization "";
        proxy_pass http://piston:2000;
    }
    location = /api/v2/execute {
        if ($piston_authorized = 0) { return 401; }
        limit_except POST { deny all; }
        limit_req zone=piston_jobs burst=20 nodelay;
        limit_req_status 429;
        proxy_set_header Authorization "";
        proxy_pass http://piston:2000;
    }
    location / { return 404; }
}
